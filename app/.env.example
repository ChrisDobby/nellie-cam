# Copy to .env.local and fill in from the NellieCamStack outputs:
#   aws cloudformation describe-stacks --stack-name NellieCamStack --query "Stacks[0].Outputs"
# These are inlined into the browser bundle at build time. None of them are secrets.
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_IDENTITY_POOL_ID=

# aws iot describe-endpoint --endpoint-type iot:Data-ATS
NEXT_PUBLIC_IOT_ENDPOINT=

NEXT_PUBLIC_STREAM_NAME=nellie-cam-live
NEXT_PUBLIC_THING_NAME=nellie-cam
