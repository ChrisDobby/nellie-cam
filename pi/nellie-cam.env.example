# Copy to /etc/nellie-cam/nellie-cam.env (install.sh does this) and fill in.
# No AWS keys go here: the Pi authenticates with its IoT certificate and gets
# temporary credentials for streaming. Don't commit the real file.

# Region the NellieCamStack was deployed to (shown by `cdk deploy`, or in the
# CloudFormation console). The service refuses to start until this is set.
AWS_REGION=

KVS_STREAM_NAME=nellie-cam-live

# AWS IoT data endpoint, in the same region as the stack. Printed by
# aws/scripts/register-device-cert.sh, or:
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_ENDPOINT=
# IoT credentials provider endpoint, used to get temporary AWS credentials. Also printed
# by register-device-cert.sh, or:
#   aws iot describe-endpoint --endpoint-type iot:CredentialProvider
IOT_CREDENTIALS_ENDPOINT=
IOT_THING_NAME=nellie-cam
IOT_ROLE_ALIAS=nellie-cam-streamer
IOT_CERT=/etc/nellie-cam/iot/device.cert.pem
IOT_KEY=/etc/nellie-cam/iot/device.key
# CAs used to verify the credentials endpoint: a directory, or a file ending in .pem.
IOT_CA=/etc/ssl/certs

VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FRAMERATE=25
VIDEO_BITRATE=2000000

# Streams stop automatically this many minutes after being started. 0 disables the limit.
STREAM_MAX_MINUTES=30

# auto picks hardware on Pi 4 and earlier, software (libx264) on Pi 5.
VIDEO_ENCODER=auto
